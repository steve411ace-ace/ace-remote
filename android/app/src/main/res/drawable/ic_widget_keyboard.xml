<?xml version="1.0" encoding="utf-8"?>
<!-- Step 32: keyboard icon for the Bàn phím pill — REDRAWN as a stroke
     outline, same visual language as the trackpad icon. The old Material
     filled keyboard was a solid silhouette whose key holes are 2x2 units
     — at 18dp they collapse into a dark/white blob, so the icon read as
     an unclear rectangle (An: "xấu, ko rõ"). An outline + 3 key dashes +
     a spacebar dash stays crisp at 18dp and matches the trackpad icon.
     White stroke — the provider tints it with setColorFilter: white when
     ON, muted grey when OFF. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M4,6 h16 a2,2 0 0,1 2,2 v8 a2,2 0 0,1 -2,2 H4 a2,2 0 0,1 -2,-2 V8 a2,2 0 0,1 2,-2 z" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M5.5,10.5 h3 M10.5,10.5 h3 M15.5,10.5 h3" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M8,14.5 h8" />
</vector>
