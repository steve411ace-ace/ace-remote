<?xml version="1.0" encoding="utf-8"?>
<!-- Step 27: widget layout 4x2. Only RemoteViews-supported views are used
     (FrameLayout / LinearLayout / TextView / ImageView — no Compose, no
     custom views). The rounded background is NOT a shape drawable:
     RemoteViews cannot set both a shape's color and its alpha, and
     setBackgroundColor would drop the rounded corners. Instead the provider
     draws a rounded-rect bitmap (solid color + alpha from the opacity
     setting) into widget_bg.
     Step 29 (redesign, Material 3):
     - Info row gains a teal icon tile with a real monitor vector icon; the
       name is bigger (17sp bold) and the address/status smaller, so the
       hierarchy is clear.
     - The switch key is now a circular ImageView with a real swap vector
       icon — the "⇄" text character is gone (some fonts render it as a
       hollow box).
     - Trackpad / Bàn phím are pill containers with an icon + a label, so
       the provider can tint the icon and the label separately for the
       ON (teal, white) / OFF (grey, muted) states.
     - The "Kết nối" button is GONE. Step 31: tapping ANYWHERE on the
       widget opens the app and connects — the provider attaches the
       launch intent to the root layout, and taps bubble up to it from
       every child without its own handler. All three remaining buttons
       are handled natively by the provider (broadcast intents) and never
       open the app.
     - The rounded background is drawn by the provider as a bitmap at the
       widget's real aspect ratio (step 31): 28dp corners, 1dp border
       (Thuoc Vui standard), so the corners stay circular on any size.
     Buttons are clickable containers: the provider attaches a
     PendingIntent to each one (RemoteViews has no onClick). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Info row (step 31: the tap handler is on the root layout,
             so tapping anywhere on the widget — icon, name, address,
             status, gaps — opens the app and connects; only the 2 pills
             and the switch key have their own handlers). -->
        <LinearLayout
            android:id="@+id/widget_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Teal icon tile (always teal, white monitor icon). -->
            <ImageView
                android:id="@+id/widget_icon_tile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_icon_tile"
                android:src="@drawable/ic_widget_monitor"
                android:padding="8dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ace Remote"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="100.101.127.41:3389"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Đã lưu • Chạm"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Switch connection: only visible when > 1 connection is saved. -->
            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_circle_off_light"
                android:src="@drawable/ic_widget_swap"
                android:padding="9dp"
                android:contentDescription="Chuyển kết nối"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Quick-action row: Trackpad / Bàn phím toggles (native, no app launch). -->
        <LinearLayout
            android:id="@+id/widget_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_btn_trackpad"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/widget_pill_off_light">

                <ImageView
                    android:id="@+id/widget_btn_trackpad_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_widget_trackpad"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_btn_trackpad_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Trackpad"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_keyboard"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/widget_pill_off_light">

                <ImageView
                    android:id="@+id/widget_btn_keyboard_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_widget_keyboard"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_btn_keyboard_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Bàn phím"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
